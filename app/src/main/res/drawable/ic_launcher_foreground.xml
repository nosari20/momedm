<?xml version="1.0" encoding="utf-8"?>
<!-- The parent as a warm sun, the child as a small cratered planet beside it (the craters are
     NightSky.kt's own offsets, scaled). The orbit is implied, not drawn — the planet still sits
     on the invisible ellipse, grazing the 66dp safe zone at 32.9 of r=33. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sun's soft halo, then the sun -->
    <path
        android:fillColor="#E9A15C"
        android:fillAlpha="0.30"
        android:pathData="M38,51 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />
    <path
        android:fillColor="#E9A15C"
        android:pathData="M41,51 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
    <path
        android:fillColor="#F2BE85"
        android:pathData="M45,47 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
    <!-- The child's planet, moon-cream with its craters -->
    <path
        android:fillColor="#F0EAD8"
        android:pathData="M68.5,62 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 Z" />
    <path
        android:fillColor="#D8CDAE"
        android:pathData="M72.8,59.6 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z" />
    <path
        android:fillColor="#D8CDAE"
        android:pathData="M77.2,64.9 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 Z" />
    <!-- Fixed stars -->
    <path
        android:fillColor="#C7D0E8"
        android:pathData="M33,30.5 L35.5,33 L33,35.5 L30.5,33 Z" />
    <path
        android:fillColor="#C7D0E8"
        android:pathData="M76,34 L78,36 L76,38 L74,36 Z" />
    <path
        android:fillColor="#C7D0E8"
        android:pathData="M34,68.2 L35.8,70 L34,71.8 L32.2,70 Z" />
</vector>
